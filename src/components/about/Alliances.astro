---
interface Alliance {
  name: string;
  icon?: string;
  colorClass?: string; // Ej: "text-orange-500"
  fontClass?: string; // Ej: "italic" o "font-bold text-xl"
}

interface Props {
  title?: string;
  alliances?: readonly Alliance[];
}

const {
  title = "Our Alliances",
  alliances = [
    { name: "SAP Member", icon: "verified" },
    { name: "VENTURESOUQ" },
    { name: "ONAPSIS", icon: "security", colorClass: "text-orange-500" },
    { name: "CyberSafe", icon: "shield", colorClass: "text-red-500" },
    { name: "VOQUZ Labs" },
    { name: "SNP", icon: "flight" },
    { name: "Panaya", icon: "circle", colorClass: "text-cyan-400" },
    { name: "kgs", fontClass: "font-bold text-xl italic" },
  ],
} = Astro.props;
---

<section
  class="py-24 px-4 lg:px-40 bg-bg-main border-t border-border-base transition-colors duration-300"
>
  <div
    class="layout-content-container mx-auto flex max-w-[1100px] flex-col gap-12 text-center"
  >
    <h2
      class="text-3xl font-bold text-text-main transition-colors duration-300"
    >
      {title}
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 opacity-80">
      {
        alliances.map((partner) => (
          <div class="h-20 flex items-center justify-center bg-text-main/5 rounded-lg border border-border-base hover:bg-text-main/10 hover:opacity-100 transition-all cursor-default group">
            <span
              class={`font-bold text-lg flex items-center gap-2 transition-colors duration-300 ${partner.colorClass ? partner.colorClass : "text-text-main"} ${partner.fontClass || ""}`}
            >
              {/* Renderiza el icono solo si existe */}
              {partner.icon && (
                <span class="material-symbols-outlined group-hover:scale-110 transition-transform">
                  {partner.icon}
                </span>
              )}

              {partner.name}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
