---
import { languages } from "../i18n/ui";
import Picker from "./Picker.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  lang: keyof typeof languages;
  navData: any; // Los textos del menú traducidos
}

const { lang, navData } = Astro.props;

// Función auxiliar para cambiar el idioma en la URL
// Si estamos en /es/about, cambiar a /en/about
const currentPath = Astro.url.pathname;
function getLangPath(targetLang: string) {
  const segments = currentPath.split("/").filter(Boolean);
  // Si el primer segmento es un idioma (ej: 'es'), lo reemplazamos
  if (segments.length > 0 && Object.keys(languages).includes(segments[0])) {
    segments[0] = targetLang;
  } else {
    // Si no hay idioma (raíz), añadimos el idioma al principio
    segments.unshift(targetLang);
  }
  return `/${segments.join("/")}`;
}

// Definimos los enlaces aquí para mantener el template limpio
// Definimos los links dinámicamente usando el idioma actual
const links = [
  { name: navData.home, href: `/${lang}` }, // Ir al inicio del idioma actual
  { name: navData.about, href: `/${lang}/about` }, // Ir a About
  { name: navData.services, href: `/${lang}/services` }, // Ir a Services
  { name: navData.contact, href: `/${lang}/contact` }, // Ir a Contact
];
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-[#111822]/90 backdrop-blur-md border-b border-white/5"
>
  <div class="layout-container flex justify-center w-full">
    <div
      class="flex max-w-[1280px] flex-1 items-center justify-between px-6 py-4 lg:px-10"
    >
      <div class="flex items-center gap-2 text-white cursor-pointer group">
        <h2
          class="text-white text-xl font-bold leading-tight tracking-tight group-hover:text-primary transition-colors"
        >
          uDefine
        </h2>
      </div>

      <div class="hidden lg:flex items-center gap-8">
        <nav class="flex items-center gap-8">
          {
            links.map((link) => (
              <a
                class="text-sm font-medium text-slate-300 hover:text-white transition-all pb-1"
                href={link.href}
              >
                {link.name}
              </a>
            ))
          }
        </nav>
        <div class="h-4 w-px bg-text-main/20"></div>

        <Picker lang={lang} />

        <button
          class="flex cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-6 bg-primary hover:bg-blue-600 text-white text-sm font-bold shadow-[0_0_20px_rgba(19,109,236,0.4)] hover:shadow-[0_0_30px_rgba(19,109,236,0.6)] transition-all duration-300"
        >
          <span class="truncate">Get Started</span>
        </button>
      </div>

      <button class="lg:hidden text-white" aria-label="Abrir menú">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Lógica del botón de tema
  const handleToggleClick = () => {
    const element = document.documentElement;
    element.classList.toggle("dark");

    const isDark = element.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  };

  document
    .getElementById("theme-toggle")
    ?.addEventListener("click", handleToggleClick);
</script>
