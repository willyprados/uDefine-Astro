---
// 1. OBLIGATORIO: Le decimos al Picker que debe recibir el idioma como Prop
interface Props {
  lang: string;
}

// 2. Extraemos el idioma exacto que nos envía el Header
const { lang: activeLocale } = Astro.props;
const pathname = Astro.url.pathname;

const languages = [
  { code: "en", label: "English", flag: "🇺🇸" },
  { code: "es", label: "Español", flag: "🇪🇸" },
  { code: "de", label: "Deutsch", flag: "🇩🇪" },
  { code: "it", label: "Italiano", flag: "🇮🇹" },
  { code: "pt", label: "Português", flag: "🇵🇹" },
];

const supportedLocales = languages.map((l) => l.code);

// 3. Buscamos el idioma basado 100% en la propiedad activa
const currentLang =
  languages.find((l) => l.code === activeLocale) || languages[1]; // Fallback a es (índice 1)

// Función para mantener la URL pero cambiar el idioma
const getPathForLocale = (targetLocale: string) => {
  const segments = pathname.split("/").filter(Boolean);
  if (segments.length > 0 && supportedLocales.includes(segments[0])) {
    segments[0] = targetLocale;
  } else {
    segments.unshift(targetLocale);
  }
  return `/${segments.join("/")}`;
};
---

<div class="relative inline-block text-left" id="language-selector">
  <button
    id="dropdown-button"
    class="flex items-center gap-1 px-2 py-1.5 text-slate-200 rounded-md hover:bg-slate-800 transition-colors border border-transparent focus:border-slate-700"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <span class="text-lg">{currentLang.flag}</span>

    <svg
      class="w-4 h-4 text-slate-400"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 9l-7 7-7-7"></path>
    </svg>
  </button>

  <div
    id="dropdown-menu"
    class="hidden absolute right-0 mt-2 w-48 bg-[#1e2330] rounded-lg shadow-xl z-50 border border-slate-700/50 py-2"
  >
    <ul role="menu">
      {
        languages.map((localeOption) => (
          <li role="menuitem">
            <a
              href={getPathForLocale(localeOption.code)}
              onclick={`localStorage.setItem('preferred-lang', '${localeOption.code}')`}
              class={`flex items-center gap-3 px-4 py-2 text-sm hover:bg-slate-700/50 transition-colors ${
                activeLocale === localeOption.code
                  ? "text-primary bg-primary/10"
                  : "text-slate-300"
              }`}
            >
              <span class="text-lg">{localeOption.flag}</span>
              <span class="flex-1">{localeOption.label}</span>

              {/* Checkmark para el idioma activo */}
              {activeLocale === localeOption.code && (
                <svg
                  class="w-4 h-4 text-primary"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<script>
  // Script limpio y seguro para Astro ViewTransitions
  function initLanguagePicker() {
    const button = document.getElementById("dropdown-button");
    const menu = document.getElementById("dropdown-menu");

    if (!button || !menu) return;

    // Usamos onclick para garantizar que el evento no se acumule/duplique al cambiar de página
    button.onclick = (e) => {
      e.stopPropagation();
      menu.classList.toggle("hidden");
      const isExpanded = !menu.classList.contains("hidden");
      button.setAttribute("aria-expanded", isExpanded.toString());
    };

    // Función para cerrar al hacer clic fuera
    const closeMenu = (e) => {
      if (!button.contains(e.target) && !menu.contains(e.target)) {
        menu.classList.add("hidden");
        button.setAttribute("aria-expanded", "false");
      }
    };

    // Removemos el evento anterior (si existía) y añadimos el nuevo
    document.removeEventListener("click", closeMenu);
    document.addEventListener("click", closeMenu);
  }

  // Inicializar al cargar y al cambiar de página
  document.addEventListener("astro:page-load", initLanguagePicker);
</script>
