---
interface Props {
  title?: string;
  description?: string;
  primaryBtnText?: string;
  primaryBtnLink?: string;
  primaryBtnIcon?: string;
  secondaryBtnText?: string;
  secondaryBtnLink?: string;
}

const {
  title = "Ready to Transform?",
  description = "Let's discuss how our SAP expertise can drive your business forward. Get in touch with our team today.",
  primaryBtnText = "Start Your Project",
  primaryBtnLink = "/contact",
  primaryBtnIcon = "rocket_launch",
  secondaryBtnText = "Contact Sales",
  secondaryBtnLink = "/contact",
} = Astro.props;
---

<section
  class="py-20 px-4 lg:px-40 bg-bg-main border-t border-border-base transition-colors duration-300"
>
  <div
    class="layout-content-container mx-auto max-w-[1000px] flex flex-col items-center text-center gap-8"
  >
    <h2
      class="text-4xl md:text-5xl font-black text-text-main tracking-tight transition-colors duration-300"
    >
      {title}
    </h2>

    <p
      class="text-text-muted text-lg max-w-[600px] transition-colors duration-300"
    >
      {description}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto mt-4">
      <a
        href={primaryBtnLink}
        class="flex items-center justify-center gap-2 rounded-xl bg-primary px-8 py-4 text-white font-bold text-lg hover:bg-blue-600 shadow-[0_0_30px_rgba(19,109,236,0.4)] hover:shadow-[0_0_40px_rgba(19,109,236,0.6)] hover:-translate-y-1 transition-all duration-300"
      >
        {primaryBtnText}
        {
          primaryBtnIcon && (
            <span class="material-symbols-outlined">{primaryBtnIcon}</span>
          )
        }
      </a>

      <a
        href={secondaryBtnLink}
        class="flex items-center justify-center gap-2 rounded-xl bg-text-main/5 border border-border-base px-8 py-4 text-text-main font-bold text-lg hover:bg-text-main/10 hover:-translate-y-1 transition-all duration-300"
      >
        {secondaryBtnText}
      </a>
    </div>
  </div>
</section>
