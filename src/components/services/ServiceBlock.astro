---
interface Feature {
  title: string;
  description: string;
}

interface TestimonialOverlay {
  quote: string;
  label: string;
}

interface Props {
  icon?: string;
  title?: string;
  description?: string;
  features?: readonly Feature[];
  imageSrc?: string;
  testimonial?: TestimonialOverlay;
}

const {
  icon = "lightbulb",
  title = "SAP Consulting Services",
  description = "Maximize the power of SAP to align perfectly with your business objectives. Our expert consultants guide you through every step of your journey, ensuring value-driven results.",
  features = [
    {
      title: "Digital Transformation",
      description: "Reimagine your business processes for the digital age.",
    },
    {
      title: "S/4 Hana Rollouts",
      description:
        "Expertise in both Greenfield and Brownfield implementations.",
    },
    {
      title: "Project Management",
      description:
        "Agile methodologies ensuring on-time and on-budget delivery.",
    },
  ],
  imageSrc = "https://images.unsplash.com/photo-1552664730-d307ca884978?q=80&w=2070&auto=format&fit=crop",
  testimonial = {
    quote:
      '"uDefine helped us navigate our S/4HANA migration with zero downtime."',
    label: "Success Story",
  },
} = Astro.props;
---

<section
  class="py-24 px-4 lg:px-40 bg-bg-main border-t border-border-base relative transition-colors duration-300"
>
  <div class="layout-content-container mx-auto max-w-[1200px]">
    <div
      class="bg-bg-card rounded-3xl border border-border-base p-8 lg:p-16 relative overflow-hidden shadow-2xl transition-colors duration-300"
    >
      <div
        class="absolute top-0 right-0 w-96 h-96 bg-primary/5 blur-[80px] rounded-full pointer-events-none transition-colors duration-300"
      >
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-center relative z-10">
        <div class="flex flex-col gap-6">
          <div
            class="size-14 rounded-xl bg-blue-500/10 flex items-center justify-center border border-blue-500/20"
          >
            <span class="material-symbols-outlined text-blue-400 text-3xl"
              >{icon}</span
            >
          </div>

          <h2
            class="text-3xl md:text-4xl font-bold text-text-main transition-colors duration-300"
          >
            {title}
          </h2>

          <p
            class="text-text-muted text-lg leading-relaxed transition-colors duration-300"
          >
            {description}
          </p>

          <div
            class="h-px w-full bg-border-base my-2 transition-colors duration-300"
          >
          </div>

          <ul class="flex flex-col gap-4">
            {
              features.map((feature) => (
                <li class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-primary mt-1">
                    check_circle
                  </span>
                  <div>
                    <h4 class="text-text-main font-bold transition-colors duration-300">
                      {feature.title}
                    </h4>
                    <p class="text-text-muted text-sm transition-colors duration-300">
                      {feature.description}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div
          class="relative h-full min-h-[400px] rounded-2xl overflow-hidden border border-border-base group transition-colors duration-300"
        >
          <img
            alt="Consulting Team Meeting"
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 group-hover:opacity-100"
            src={imageSrc}
          />

          <div
            class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent pointer-events-none"
          >
          </div>

          <div class="absolute bottom-8 left-8 right-8">
            <div
              class="bg-black/40 backdrop-blur-md p-6 rounded-xl border border-white/10 shadow-lg"
            >
              <p class="text-white font-medium italic">
                {testimonial.quote}
              </p>
              <div class="flex items-center gap-2 mt-3">
                <div
                  class="size-2 rounded-full bg-green-500 shadow-[0_0_10px_#22c55e]"
                >
                </div>
                <span
                  class="text-xs text-white/80 uppercase tracking-wider font-bold"
                >
                  {testimonial.label}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
