---
interface Service {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  subTitle?: string;
  title?: string;
  services?: readonly Service[];
}

const {
  subTitle = "Our Expertise",
  title = "Specialized Services for the Modern Enterprise",
  services = [
    {
      icon: "palette",
      title: "SAP Fiori Design",
      description:
        "Creating intuitive UX/UI and custom apps that users love, strictly following Fiori guidelines while pushing creative boundaries.",
    },
    {
      icon: "lightbulb",
      title: "Strategic Consulting",
      description:
        "Guiding your S/4HANA migration and architecture decisions with roadmaps that align technology with business goals.",
    },
    {
      icon: "hub",
      title: "System Integration",
      description:
        "Seamless connectivity across your entire enterprise landscape, ensuring data flows efficiently between SAP and non-SAP systems.",
    },
  ],
} = Astro.props;
---

<section class="py-20 px-4 lg:px-40 bg-[#0d1219] relative overflow-hidden">
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-1/2 h-1/2 bg-primary/5 blur-[120px] rounded-full pointer-events-none"
  >
  </div>

  <div
    class="layout-content-container mx-auto flex max-w-[1100px] flex-col gap-12 relative z-10"
  >
    <div class="flex flex-col gap-4 text-center md:text-left">
      <h2 class="text-primary text-sm font-bold uppercase tracking-widest">
        {subTitle}
      </h2>
      <h1
        class="text-white text-3xl md:text-4xl font-bold leading-tight max-w-[720px]"
      >
        {title}
      </h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {
        services.map((item) => (
          <div class="group flex flex-col gap-6 rounded-xl border border-white/5 bg-background-card p-8 hover:border-primary/50 hover:shadow-[0_0_30px_rgba(19,109,236,0.1)] transition-all duration-300 hover:-translate-y-1">
            <div class="size-14 rounded-lg bg-[#1a2332] flex items-center justify-center group-hover:bg-primary transition-colors duration-300">
              <span class="material-symbols-outlined text-white text-3xl group-hover:scale-110 transition-transform">
                {item.icon}
              </span>
            </div>
            <div class="flex flex-col gap-3">
              <h2 class="text-white text-xl font-bold">{item.title}</h2>
              <p class="text-slate-400 text-sm leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
