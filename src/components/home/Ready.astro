---
interface Props {
  title?: string;
  subtitle?: string;
  btnPrimary?: string;
  btnSecondary?: string;
  linkPrimary?: string;
  linkSecondary?: string;
}

const {
  title,
  subtitle,
  btnPrimary,
  btnSecondary,
  linkPrimary,
  linkSecondary,
} = Astro.props;
---

<section class="py-24 px-4 relative overflow-hidden">
  <div
    class="absolute inset-0 bg-gradient-to-r from-primary/10 to-blue-900/20 z-0 pointer-events-none"
  >
  </div>

  <div
    class="layout-content-container mx-auto flex max-w-[800px] flex-col items-center gap-8 text-center relative z-10"
  >
    <h1 class="text-white text-4xl md:text-5xl font-black leading-tight">
      {title}
    </h1>

    <p class="text-slate-300 text-lg max-w-[600px]">
      {subtitle}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 w-full justify-center mt-4">
      <a
        href={linkPrimary}
        class="flex min-w-[200px] cursor-pointer items-center justify-center rounded-lg h-14 px-8 bg-primary hover:bg-blue-600 text-white text-lg font-bold shadow-[0_0_30px_rgba(19,109,236,0.6)] hover:shadow-[0_0_50px_rgba(19,109,236,0.8)] transition-all duration-300 transform hover:-translate-y-1"
      >
        {btnPrimary}
      </a>

      <a
        href={linkSecondary}
        class="flex min-w-[200px] cursor-pointer items-center justify-center rounded-lg h-14 px-8 bg-transparent border border-white/20 hover:bg-white/5 text-white text-lg font-bold transition-all duration-300 hover:-translate-y-1"
      >
        {btnSecondary}
      </a>
    </div>
  </div>
</section>
