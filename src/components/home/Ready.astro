---
interface Props {
  title?: string;
  subtitle?: string;
  btnPrimary?: string;
  btnSecondary?: string;
  linkPrimary?: string;
  linkSecondary?: string;
}

const {
  title,
  subtitle,
  btnPrimary,
  btnSecondary,
  linkPrimary,
  linkSecondary,
} = Astro.props;
---

<section
  class="py-24 px-4 relative overflow-hidden bg-bg-main transition-colors duration-300"
>
  <div
    class="absolute inset-0 bg-gradient-to-r from-primary/10 to-primary/5 z-0 pointer-events-none transition-colors duration-300"
  >
  </div>

  <div
    class="layout-content-container mx-auto flex max-w-[800px] flex-col items-center gap-8 text-center relative z-10"
  >
    <h1
      class="text-text-main text-4xl md:text-5xl font-black leading-tight transition-colors duration-300"
    >
      {title}
    </h1>

    <p
      class="text-text-muted text-lg max-w-[600px] transition-colors duration-300"
    >
      {subtitle}
    </p>

    <div class="flex flex-col sm:flex-row gap-4 w-full justify-center mt-4">
      <a
        href={linkPrimary}
        class="flex min-w-[200px] cursor-pointer items-center justify-center rounded-lg h-14 px-8 bg-primary hover:bg-blue-600 text-white text-lg font-bold shadow-[0_0_30px_rgba(19,109,236,0.6)] hover:shadow-[0_0_50px_rgba(19,109,236,0.8)] transition-all duration-300 transform hover:-translate-y-1"
      >
        {btnPrimary}
      </a>

      <a
        href={linkSecondary}
        class="flex min-w-[200px] cursor-pointer items-center justify-center rounded-lg h-14 px-8 bg-transparent border border-border-base hover:bg-text-main/5 text-text-main text-lg font-bold transition-all duration-300 hover:-translate-y-1"
      >
        {btnSecondary}
      </a>
    </div>
  </div>
</section>
