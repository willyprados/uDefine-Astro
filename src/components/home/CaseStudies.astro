---
interface Study {
  title: string;
  category: string;
  description: string;
  image: string;
  link: string;
}

interface Props {
  subTitle?: string;
  title?: string;
  studies?: readonly Study[];
}

const { subTitle, title, studies = [] } = Astro.props;
---

<section
  class="py-20 px-4 lg:px-40 bg-bg-main border-t border-border-base transition-colors duration-300"
>
  <div
    class="layout-content-container mx-auto flex max-w-[1100px] flex-col gap-10"
  >
    <div class="flex justify-between items-end">
      <div class="flex flex-col gap-3">
        <h2 class="text-primary text-sm font-bold uppercase tracking-widest">
          {subTitle}
        </h2>
        <h1
          class="text-text-main text-3xl md:text-4xl font-bold transition-colors duration-300"
        >
          {title}
        </h1>
      </div>

      <div class="hidden md:flex gap-2">
        <button
          id="scroll-left"
          class="size-10 rounded-full border border-border-base flex items-center justify-center text-text-main hover:bg-border-base transition-colors duration-300 cursor-pointer"
          aria-label="Scroll left"
        >
          <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <button
          id="scroll-right"
          class="size-10 rounded-full border border-border-base flex items-center justify-center text-text-main hover:bg-border-base transition-colors duration-300 cursor-pointer"
          aria-label="Scroll right"
        >
          <span class="material-symbols-outlined">arrow_forward</span>
        </button>
      </div>
    </div>

    <div
      id="studies-container"
      class="flex overflow-x-auto gap-6 pb-8 no-scrollbar snap-x scroll-smooth"
    >
      {
        studies.map((study) => (
          <div class="flex min-w-[300px] md:min-w-[360px] flex-col gap-4 rounded-xl bg-bg-card border border-border-base p-4 snap-center hover:border-primary/30 transition-colors duration-300">
            <div
              class="w-full aspect-video bg-cover bg-center rounded-lg relative overflow-hidden group"
              role="img"
              aria-label={study.title}
              style={`background-image: url('${study.image}');`}
            >
              <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-all" />
            </div>

            <div class="flex flex-col gap-2 p-2">
              <div class="flex justify-between items-start">
                <h3 class="text-text-main text-lg font-bold transition-colors duration-300">
                  {study.title}
                </h3>
                <span class="text-xs font-medium bg-primary/10 border border-primary/20 text-primary px-2 py-1 rounded">
                  {study.category}
                </span>
              </div>
              <p class="text-text-muted text-sm h-14 overflow-hidden transition-colors duration-300">
                {study.description}
              </p>

              <a
                class="text-primary text-sm font-bold mt-2 flex items-center gap-1 hover:gap-2 transition-all w-fit"
                href={study.link}
              >
                Read Story
                <span class="material-symbols-outlined text-sm">
                  arrow_forward
                </span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Lógica para que las flechas desplacen el carrusel
  function initCarousel() {
    const container = document.getElementById("studies-container");
    const btnLeft = document.getElementById("scroll-left");
    const btnRight = document.getElementById("scroll-right");

    if (!container || !btnLeft || !btnRight) return;

    // Calculamos cuánto desplazar (el ancho de una tarjeta aprox)
    const scrollAmount = 384;

    // Removemos eventos previos para no duplicar al usar ViewTransitions
    btnLeft.onclick = () => {
      container.scrollBy({ left: -scrollAmount, behavior: "smooth" });
    };

    btnRight.onclick = () => {
      container.scrollBy({ left: scrollAmount, behavior: "smooth" });
    };
  }

  // Ejecutamos en la carga inicial y en cada navegación de Astro
  document.addEventListener("astro:page-load", initCarousel);
</script>
