---
interface Study {
  title: string;
  category: string;
  description: string;
  image: string;
  link: string;
}

interface Props {
  subTitle?: string;
  title?: string;
  studies?: readonly Study[];
}

const { subTitle, title, studies = [] } = Astro.props;
---

<section class="py-20 px-4 lg:px-40 bg-background-dark border-t border-white/5">
  <div
    class="layout-content-container mx-auto flex max-w-[1100px] flex-col gap-10"
  >
    <div class="flex justify-between items-end">
      <div class="flex flex-col gap-3">
        <h2 class="text-primary text-sm font-bold uppercase tracking-widest">
          {subTitle}
        </h2>
        <h1 class="text-white text-3xl md:text-4xl font-bold">
          {title}
        </h1>
      </div>

      <div class="hidden md:flex gap-2">
        <button
          id="scroll-left"
          class="size-10 rounded-full border border-white/10 flex items-center justify-center text-white hover:bg-white/10 transition-colors cursor-pointer"
          aria-label="Scroll left"
        >
          <span class="material-symbols-outlined">arrow_back</span>
        </button>
        <button
          id="scroll-right"
          class="size-10 rounded-full border border-white/10 flex items-center justify-center text-white hover:bg-white/10 transition-colors cursor-pointer"
          aria-label="Scroll right"
        >
          <span class="material-symbols-outlined">arrow_forward</span>
        </button>
      </div>
    </div>

    <div
      id="studies-container"
      class="flex overflow-x-auto gap-6 pb-8 no-scrollbar snap-x scroll-smooth"
    >
      {
        studies.map((study) => (
          <div class="flex min-w-[300px] md:min-w-[360px] flex-col gap-4 rounded-xl bg-background-card border border-white/5 p-4 snap-center hover:border-primary/30 transition-colors">
            <div
              class="w-full aspect-video bg-cover bg-center rounded-lg relative overflow-hidden group"
              role="img"
              aria-label={study.title}
              style={`background-image: url('${study.image}');`}
            >
              <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-all" />
            </div>

            <div class="flex flex-col gap-2 p-2">
              <div class="flex justify-between items-start">
                <h3 class="text-white text-lg font-bold">{study.title}</h3>
                <span class="text-xs font-medium bg-primary/20 text-primary px-2 py-1 rounded">
                  {study.category}
                </span>
              </div>
              <p class="text-slate-400 text-sm h-14 overflow-hidden">
                {study.description}
              </p>
              <a
                class="text-primary text-sm font-bold mt-2 flex items-center gap-1 hover:gap-2 transition-all"
                href={study.link}
              >
                Read Story
                <span class="material-symbols-outlined text-sm">
                  arrow_forward
                </span>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Lógica simple para los botones de scroll
  const container = document.getElementById("studies-container");
  const leftBtn = document.getElementById("scroll-left");
  const rightBtn = document.getElementById("scroll-right");

  if (container && leftBtn && rightBtn) {
    leftBtn.addEventListener("click", () => {
      container.scrollBy({ left: -400, behavior: "smooth" });
    });

    rightBtn.addEventListener("click", () => {
      container.scrollBy({ left: 400, behavior: "smooth" });
    });
  }
</script>
