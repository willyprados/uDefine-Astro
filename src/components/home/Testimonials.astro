---
interface Testimonial {
  quote: string;
  author: string;
  role: string;
  initials: string; // Para el avatar (ej: "CA", "PM")
}

interface Props {
  subTitle?: string;
  title?: string;
  testimonials?: readonly Testimonial[];
}

const { subTitle, title, testimonials = [] } = Astro.props;
---

<section id="success-stories" class="py-20 px-4 lg:px-40 bg-[#0d1219]">
  <div
    class="layout-content-container mx-auto flex max-w-[1100px] flex-col gap-12"
  >
    <div class="flex flex-col gap-4 text-center items-center">
      <h2 class="text-primary text-sm font-bold uppercase tracking-widest">
        {subTitle}
      </h2>
      <h1 class="text-white text-3xl md:text-4xl font-bold max-w-[720px]">
        {title}
      </h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        testimonials.map((item) => (
          <div class="flex flex-col justify-between gap-6 rounded-xl border border-white/5 bg-background-card p-8 hover:border-primary/50 hover:shadow-[0_0_30px_rgba(19,109,236,0.1)] transition-all duration-300">
            <div class="flex flex-col gap-4">
              <span class="testimonial material-symbols-outlined text-primary opacity-50">
                format_quote
              </span>
              <p class="text-slate-300 leading-relaxed italic">
                "{item.quote}"
              </p>
            </div>

            <div class="flex items-center gap-4 pt-6 border-t border-white/5">
              <div class="size-12 rounded-full bg-gradient-to-br from-gray-700 to-gray-900 flex items-center justify-center text-white font-bold border border-white/10 shrink-0">
                {item.initials}
              </div>

              <div class="flex flex-col">
                <h4 class="text-white font-bold">{item.author}</h4>
                <span class="text-sm text-primary">{item.role}</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
