---
// --- Lógica del Servidor (Opcional para evitar parpadeos iniciales) ---
// Intenta leer el tema de una cookie para establecer el estado inicial
const initialTheme = Astro.cookies.get("theme")?.value || "light";
---

<button
  id="theme-toggle"
  type="button"
  class="text-gray-100 dark:text-gray-400 hover:bg-gray-100 hover:bg-slate-800 transition-colors border border-transparent focus:border-slate-700 rounded-md text-sm p-2.5 inline-flex items-center justify-center"
  aria-label="Toggle theme"
>
  <svg
    id="theme-toggle-light-icon"
    class={`w-5 h-5 ${initialTheme === "dark" ? "block" : "hidden"}`}
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      fill-rule="evenodd"
      clip-rule="evenodd"></path>
  </svg>

  <svg
    id="theme-toggle-dark-icon"
    class={`w-5 h-5 ${initialTheme === "light" ? "block" : "hidden"}`}
    fill="currentColor"
    viewBox="0 0 20 20"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
    ></path>
  </svg>
</button>

<script>
  // Función para verificar y aplicar el tema al cargar la página
  function applyInitialTheme() {
    const userTheme = localStorage.getItem("theme");
    const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
      .matches
      ? "dark"
      : "light";

    // Usa el tema guardado o el del sistema si no hay nada guardado
    const currentTheme = userTheme || systemTheme;

    if (currentTheme === "dark") {
      document.documentElement.classList.add("dark");
    } else {
      document.documentElement.classList.remove("dark");
    }
    // Actualiza los iconos para que coincidan con el tema aplicado
    updateIcons(currentTheme === "dark");
  }

  // Función para actualizar la visibilidad de los iconos
  function updateIcons(isDark: boolean) {
    const themeToggleDarkIcon = document.getElementById(
      "theme-toggle-dark-icon",
    );
    const themeToggleLightIcon = document.getElementById(
      "theme-toggle-light-icon",
    );

    if (themeToggleDarkIcon && themeToggleLightIcon) {
      if (isDark) {
        themeToggleDarkIcon.classList.add("hidden");
        themeToggleLightIcon.classList.remove("hidden");
      } else {
        themeToggleDarkIcon.classList.remove("hidden");
        themeToggleLightIcon.classList.add("hidden");
      }
    }
  }

  // Ejecutar la comprobación inicial
  applyInitialTheme();

  // Configurar el evento de clic del botón
  const themeToggleBtn = document.getElementById("theme-toggle");

  themeToggleBtn?.addEventListener("click", function () {
    // Alternar la clase 'dark' en el elemento raíz <html>
    document.documentElement.classList.toggle("dark");

    const isDark = document.documentElement.classList.contains("dark");

    // Guardar la preferencia del usuario
    localStorage.setItem("theme", isDark ? "dark" : "light");

    // Actualizar los iconos
    updateIcons(isDark);
  });

  // Asegura que el script funcione correctamente con las View Transitions de Astro
  document.addEventListener("astro:after-swap", applyInitialTheme);
</script>
