---
interface Props {
  title?: string;
  name?: string;
  email?: string;
  company?: string;
  service?: string;
  servicePlaceholder?: string;
  serviceOpt1?: string;
  serviceOpt2?: string;
  serviceOpt3?: string;
  serviceOpt4?: string;
  message?: string;
  send?: string;
}

const {
  title,
  name,
  email,
  company,
  service,
  servicePlaceholder,
  serviceOpt1,
  serviceOpt2,
  serviceOpt3,
  serviceOpt4,
  message,
  send,
} = Astro.props;
---

<div class="relative group">
  <div
    class="absolute inset-0 bg-gradient-to-r from-primary/20 to-blue-600/20 rounded-3xl blur-xl opacity-50 group-hover:opacity-75 transition-opacity duration-500"
  >
  </div>

  <div
    class="relative bg-bg-card/60 backdrop-blur-xl border border-border-base p-8 md:p-10 rounded-3xl shadow-2xl overflow-hidden transition-colors duration-300"
  >
    <div
      class="absolute top-0 right-0 w-32 h-32 bg-primary/10 blur-[50px] rounded-full pointer-events-none transition-colors duration-300"
    >
    </div>

    <h3
      class="text-2xl font-bold text-text-main mb-6 transition-colors duration-300"
    >
      {title}
    </h3>

    <form id="contact-form" class="flex flex-col gap-6">
      <div class="flex flex-col gap-2">
        <label
          class="text-text-muted text-sm font-medium ml-1 transition-colors duration-300"
          >{name}</label
        >
        <div class="relative">
          <input
            class="w-full bg-bg-main border border-border-base rounded-xl px-5 py-3.5 text-text-main placeholder:text-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all duration-300"
            placeholder="John Doe"
            type="text"
          />
          <span
            class="material-symbols-outlined absolute right-4 top-3.5 text-text-muted transition-colors duration-300"
            >person</span
          >
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <label
          class="text-text-muted text-sm font-medium ml-1 transition-colors duration-300"
          >{email}</label
        >
        <div class="relative">
          <input
            class="w-full bg-bg-main border border-border-base rounded-xl px-5 py-3.5 text-text-main placeholder:text-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all duration-300"
            placeholder="john@company.com"
            type="email"
          />
          <span
            class="material-symbols-outlined absolute right-4 top-3.5 text-text-muted transition-colors duration-300"
            >mail</span
          >
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <label
          class="text-text-muted text-sm font-medium ml-1 transition-colors duration-300"
          >{company}</label
        >
        <div class="relative">
          <input
            class="w-full bg-bg-main border border-border-base rounded-xl px-5 py-3.5 text-text-main placeholder:text-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all duration-300"
            placeholder="Your Company Name"
            type="text"
          />
          <span
            class="material-symbols-outlined absolute right-4 top-3.5 text-text-muted transition-colors duration-300"
            >business</span
          >
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <label
          class="text-text-muted text-sm font-medium ml-1 transition-colors duration-300"
          >{service}</label
        >
        <div class="relative">
          <select
            class="w-full bg-bg-main border border-border-base rounded-xl px-5 py-3.5 text-text-main focus:border-primary focus:ring-1 focus:ring-primary outline-none appearance-none transition-all duration-300 cursor-pointer"
          >
            <option disabled selected value="" class="bg-bg-main text-text-main"
              >{servicePlaceholder}</option
            >
            <option value="consulting" class="bg-bg-main text-text-main"
              >{serviceOpt1}</option
            >
            <option value="fiori" class="bg-bg-main text-text-main"
              >{serviceOpt2}</option
            >
            <option value="operations" class="bg-bg-main text-text-main"
              >{serviceOpt3}</option
            >
            <option value="other" class="bg-bg-main text-text-main"
              >{serviceOpt4}</option
            >
          </select>
          <span
            class="material-symbols-outlined absolute right-4 top-3.5 text-text-muted pointer-events-none transition-colors duration-300"
            >expand_more</span
          >
        </div>
      </div>

      <div class="flex flex-col gap-2">
        <label
          class="text-text-muted text-sm font-medium ml-1 transition-colors duration-300"
          >{message}</label
        >
        <textarea
          class="w-full bg-bg-main border border-border-base rounded-xl px-5 py-3.5 text-text-main placeholder:text-text-muted focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-all duration-300 resize-none"
          placeholder="..."
          rows="4"></textarea>
      </div>

      <button
        class="mt-2 flex items-center justify-center gap-2 w-full rounded-xl bg-primary px-8 py-4 text-white font-bold text-lg hover:bg-blue-600 shadow-[0_0_20px_rgba(19,109,236,0.4)] hover:shadow-[0_0_30px_rgba(19,109,236,0.6)] transition-all duration-300 group-hover:scale-[1.02]"
        type="submit"
      >
        {send}
        <span class="material-symbols-outlined text-sm">send</span>
      </button>
    </form>
  </div>
</div>

<script>
  const contactForm = document.getElementById("contact-form");
  if (contactForm) {
    contactForm.addEventListener("submit", (e) => {
      e.preventDefault();
      console.log("Formulario de uDefine enviado");
    });
  }
</script>
