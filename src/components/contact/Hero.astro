---
interface Props {
  badge?: string;
  title1?: string;
  titleHighlight?: string;
  subtitle?: string;
}

const { badge, title1, titleHighlight, subtitle } = Astro.props;
---

<section
  class="relative flex flex-col items-center justify-center overflow-hidden px-4 py-24 bg-bg-main transition-colors duration-300"
>
  <div class="absolute inset-0 z-0">
    <div
      class="absolute inset-0 bg-gradient-to-br from-bg-main via-bg-main to-primary/10 transition-colors duration-300"
    >
    </div>

    <div
      class="absolute inset-0 bg-grid-pattern bg-[length:40px_40px] opacity-10 dark:opacity-30 transition-opacity duration-300"
    >
    </div>

    <div
      class="absolute top-0 right-1/4 w-[600px] h-[400px] bg-primary/10 blur-[120px] rounded-full pointer-events-none transition-colors duration-300"
    >
    </div>
    <div
      class="absolute bottom-0 left-1/4 w-[500px] h-[300px] bg-blue-600/10 blur-[100px] rounded-full pointer-events-none transition-colors duration-300"
    >
    </div>
  </div>

  <div
    class="layout-content-container relative z-20 flex max-w-[960px] flex-col items-center gap-6 text-center animate-in fade-in slide-in-from-bottom-8 duration-1000"
  >
    <div
      class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-text-main/5 border border-border-base text-primary text-sm font-medium mb-2 transition-colors duration-300"
    >
      <span class="flex h-2 w-2 rounded-full bg-primary animate-pulse"></span>
      {badge}
    </div>

    <h1
      class="text-text-main text-5xl md:text-7xl font-black leading-tight tracking-tight drop-shadow-2xl transition-colors duration-300"
    >
      {title1}
      <br />
      <span
        class="text-transparent bg-clip-text bg-gradient-to-r from-text-main via-primary to-blue-500 transition-colors duration-300"
      >
        {titleHighlight}
      </span>
    </h1>

    <p
      class="max-w-[700px] text-text-muted text-lg md:text-xl font-normal leading-relaxed transition-colors duration-300"
    >
      {subtitle}
    </p>
  </div>
</section>
