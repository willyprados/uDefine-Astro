---
import { languages, ui } from "../../i18n/ui";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/about/Hero.astro";
import Team from "../../components/about/Team.astro";
import Expertise from "../../components/about/Expertise.astro";
import Evolution from "../../components/about/Evolution.astro";
import Careers from "../../components/about/Careers.astro";
import Alliances from "../../components/about/Alliances.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "de" } },
    { params: { lang: "it" } },
    { params: { lang: "pt" } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as keyof typeof ui] || ui.es;
const about = t.about; // Atajo para la sección about
---

<Layout
  title={`uDefine - ${languages[lang as keyof typeof languages]?.label || "Consulting"}`}
>
  <Hero
    title={about.hero.title}
    subtitle={about.hero.subtitle}
    backgroundImage="https://images.unsplash.com/photo-1517245386807-bb43f82c33c4?q=80&w=2070&auto=format&fit=crop"
  />
  <Team
    title={about.teamIntro.title}
    subtitle={about.teamIntro.subtitle}
    description={about.teamIntro.description}
  />
  <Expertise
    title={about.languageExpertise.title}
    features={about.languageExpertise.features}
  />
  <Evolution
    title={about.evolution.title}
    description={about.evolution.description}
  />
  <Careers
    title={about.careers.title}
    description={about.careers.description}
    checklist={about.careers.checklist}
    ctaText={about.careers.ctaText}
    ctaLink={`/${lang}${about.careers.ctaLink}`}
  />
  <Alliances title={about.alliances.title} alliances={about.alliances.items} />
</Layout>
