---
import Layout from "../../layouts/Layout.astro";
// src/pages/[lang]/services.astro
import { languages, ui } from "../../i18n/ui";

// 1. OBLIGATORIO: Generar las rutas para esta página también
export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "de" } },
    { params: { lang: "it" } },
    { params: { lang: "pt" } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang] || ui.es; // Cargar traducciones
