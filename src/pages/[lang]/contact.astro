---
import { languages, ui } from "../../i18n/ui";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/contact/Hero.astro";
import Form from "../../components/contact/Form.astro";
import Info from "../../components/contact/Info.astro";

export function getStaticPaths() {
  return [
    { params: { lang: "en" } },
    { params: { lang: "es" } },
    { params: { lang: "de" } },
    { params: { lang: "it" } },
    { params: { lang: "pt" } },
  ];
}

const { lang } = Astro.params;
const t = ui[lang as keyof typeof ui] || ui.es;
const contact = t.contact;
---

<Layout
  title={`uDefine - ${languages[lang as keyof typeof languages]?.label || "Consulting"}`}
>
  <main class="flex flex-col min-h-screen pt-16">
    <Hero
      badge={contact.badge}
      title1={contact.hero.title1}
      titleHighlight={contact.hero.titleHighlight}
      subtitle={contact.hero.subtitle}
    />

    <section
      class="py-20 px-4 lg:px-40 bg-surface-dark border-t border-white/5 relative"
    >
      <div class="layout-content-container mx-auto max-w-[1200px]">
        <div class="grid lg:grid-cols-2 gap-16 lg:gap-24">
          <Form {...contact.form} />
          <Info {...contact.info} />
        </div>
      </div>
    </section>
  </main>
</Layout>
