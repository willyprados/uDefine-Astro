---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ui } from "../i18n/ui";
// src/layouts/Layout.astro
import "../styles/global.css"; // <--- ¡ESTA LÍNEA ES LA CLAVE!
interface Props {
  title: string;
  // Necesitamos pasar el idioma al layout para que header/footer funcionen
  lang?: string;
}

// Obtenemos el idioma de la URL o usamos 'es' por defecto
const { lang = "es", title } = Astro.props;

// Obtenemos los textos traducidos para Header y Footer
const t = ui[lang] || ui.es;
// src/layouts/Layout.astro
interface Props {
  title: string;
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0"
    />
  </head>
  <body class="bg-[#0b111a]">
    <Header lang={lang} navData={t.nav} />
    <slot />
    <Footer lang={lang} content={t.footer} />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
